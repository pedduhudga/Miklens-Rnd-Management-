rules_version = '2';

// Security rules for the Miklens R&D Firestore database.
//
// Role model: each authenticated user has a corresponding `users/{uid}`
// document with a `role` field of Admin | Manager | Scientist | Viewer.
// This must stay in sync with the UserRole type in src/contexts/AuthContext.tsx.
// Client-side role checks (e.g. Settings page nav gating) are for UX only —
// these rules are the actual enforcement boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return isSignedIn() && currentRole() in roles;
    }

    function isAdmin() {
      return hasRole(['Admin']);
    }

    function isAdminOrManager() {
      return hasRole(['Admin', 'Manager']);
    }

    // Users can always read their own profile (needed for role lookups on
    // login); only Admins can read the full directory or write role changes.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'Viewer';
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Any signed-in user can read operational data; only Manager/Admin can
    // create or modify products, employees records, and experiments.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }

    // Daily logs can be created by any signed-in user (for their own uid),
    // but only the Cloud Function (admin SDK, bypasses rules) may write the
    // aiNotes/aiRecommendations fields back — enforced by disallowing client
    // updates entirely here.
    match /daily_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
